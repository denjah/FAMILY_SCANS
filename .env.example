# Local archive paths (not needed on Vercel)
ARCHIVE_ROOT=
ARCHIVE_DATA_ROOT=

# Authentication — generate distinct long random values and keep them secret.
ARCHIVE_SESSION_SECRET=
ARCHIVE_SESSION_VERSION=1
ARCHIVE_FAMILY_PASSWORD_HASH=
ARCHIVE_ADMIN_PASSWORD_HASH=
ARCHIVE_INVITE_TOKEN=
ARCHIVE_PUBLIC_ORIGIN=

# Bidirectional comment sync between local SQLite and the shared Vercel database.
# Set the same random secret (32+ characters) in both environments.
ARCHIVE_COMMENT_SYNC_URL=https://<vercel-domain>/api/admin/comments-sync
ARCHIVE_COMMENT_SYNC_SECRET=

# Hosted screen archive. The service account must have Reader access only to this folder.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
